  <decision id="decision_confidence" name="confidence">
    <description>Fuentes independientes que apoyan la causa y contradicciones (criterio de monitor_output.md). Criterio propuesto para la E6, no derivado de datos.</description>
    <decisionTable id="table_confidence" hitPolicy="FIRST">
      <input id="confidence_in_0" label="cause">
        <inputExpression id="confidence_ie_0">
          <text>cause</text>
        </inputExpression>
      </input>
      <input id="confidence_in_1" label="n_support">
        <inputExpression id="confidence_ie_1">
          <text>n_support</text>
        </inputExpression>
      </input>
      <input id="confidence_in_2" label="n_contra">
        <inputExpression id="confidence_ie_2">
          <text>n_contra</text>
        </inputExpression>
      </input>
      <output id="confidence_out_0" name="confidence"/>
      <rule id="confidence_K01">
        <description>K01: unknown cause: a conjecture</description>
        <inputEntry id="K01_i0">
          <text>&quot;UNKNOWN&quot;</text>
        </inputEntry>
        <inputEntry id="K01_i1">
          <text>-</text>
        </inputEntry>
        <inputEntry id="K01_i2">
          <text>-</text>
        </inputEntry>
        <outputEntry id="K01_o0">
          <text>0.3</text>
        </outputEntry>
      </rule>
      <rule id="confidence_K02">
        <description>K02: two or more sources and nothing against</description>
        <inputEntry id="K02_i0">
          <text>-</text>
        </inputEntry>
        <inputEntry id="K02_i1">
          <text>&gt;= 2</text>
        </inputEntry>
        <inputEntry id="K02_i2">
          <text>0</text>
        </inputEntry>
        <outputEntry id="K02_o0">
          <text>0.8</text>
        </outputEntry>
      </rule>
      <rule id="confidence_K03">
        <description>K03: two or more sources and one contradiction, or one source and nothing against</description>
        <inputEntry id="K03_i0">
          <text>-</text>
        </inputEntry>
        <inputEntry id="K03_i1">
          <text>&gt;= 2</text>
        </inputEntry>
        <inputEntry id="K03_i2">
          <text>1</text>
        </inputEntry>
        <outputEntry id="K03_o0">
          <text>0.6</text>
        </outputEntry>
      </rule>
      <rule id="confidence_K04">
        <description>K04: one source and nothing against</description>
        <inputEntry id="K04_i0">
          <text>-</text>
        </inputEntry>
        <inputEntry id="K04_i1">
          <text>1</text>
        </inputEntry>
        <inputEntry id="K04_i2">
          <text>0</text>
        </inputEntry>
        <outputEntry id="K04_o0">
          <text>0.6</text>
        </outputEntry>
      </rule>
      <rule id="confidence_K05">
        <description>K05: one source with a contradiction, or several contradictions</description>
        <inputEntry id="K05_i0">
          <text>-</text>
        </inputEntry>
        <inputEntry id="K05_i1">
          <text>&gt;= 1</text>
        </inputEntry>
        <inputEntry id="K05_i2">
          <text>-</text>
        </inputEntry>
        <outputEntry id="K05_o0">
          <text>0.4</text>
        </outputEntry>
      </rule>
      <rule id="confidence_K06">
        <description>K06: nothing supports it</description>
        <inputEntry id="K06_i0">
          <text>-</text>
        </inputEntry>
        <inputEntry id="K06_i1">
          <text>-</text>
        </inputEntry>
        <inputEntry id="K06_i2">
          <text>-</text>
        </inputEntry>
        <outputEntry id="K06_o0">
          <text>0.3</text>
        </outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
