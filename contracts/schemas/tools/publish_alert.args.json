{
  "$defs": {
    "AlertChecks": {
      "additionalProperties": false,
      "description": "Comprobaciones que el monitor declara antes de elegir la causa (para que el operador vea\npor qué se decidió). El módulo las contrasta con los resultados de las tools de la\ninvocación y con el estado.",
      "properties": {
        "gps_alert_recent": {
          "title": "Gps Alert Recent",
          "type": "boolean"
        },
        "gps_radar_disagreed": {
          "title": "Gps Radar Disagreed",
          "type": "boolean"
        },
        "wind_notable": {
          "title": "Wind Notable",
          "type": "boolean"
        },
        "wind_with_drift": {
          "title": "Wind With Drift",
          "type": "boolean"
        },
        "link_checked": {
          "title": "Link Checked",
          "type": "boolean"
        },
        "link_anomalous": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Link Anomalous"
        }
      },
      "required": [
        "gps_alert_recent",
        "gps_radar_disagreed",
        "wind_notable",
        "wind_with_drift",
        "link_checked",
        "link_anomalous"
      ],
      "title": "AlertChecks",
      "type": "object"
    },
    "Cause": {
      "description": "Causas del diagnóstico (`REPLAY` queda reservada para el futuro).",
      "enum": [
        "WIND",
        "HIJACK",
        "GPS_SPOOFING",
        "SENSOR_FAULT",
        "GPS_JAMMING",
        "UNKNOWN"
      ],
      "title": "Cause",
      "type": "string"
    },
    "Severity": {
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "title": "Severity",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "detection_ids": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Detection Ids"
    },
    "cause": {
      "$ref": "#/$defs/Cause"
    },
    "severity": {
      "$ref": "#/$defs/Severity"
    },
    "confidence": {
      "maximum": 1,
      "minimum": 0,
      "title": "Confidence",
      "type": "number"
    },
    "evidence_event_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Evidence Event Ids",
      "type": "array"
    },
    "summary": {
      "maxLength": 160,
      "title": "Summary",
      "type": "string"
    },
    "explanation": {
      "title": "Explanation",
      "type": "string"
    },
    "recommendation": {
      "title": "Recommendation",
      "type": "string"
    },
    "supersedes": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Supersedes"
    },
    "checks": {
      "anyOf": [
        {
          "$ref": "#/$defs/AlertChecks"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "cause",
    "severity",
    "confidence",
    "evidence_event_ids",
    "summary",
    "explanation",
    "recommendation"
  ],
  "title": "PublishAlertArgs",
  "type": "object"
}
