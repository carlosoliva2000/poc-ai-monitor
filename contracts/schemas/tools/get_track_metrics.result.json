{
  "$defs": {
    "GpsRadarFact": {
      "additionalProperties": false,
      "description": "Hecho calculado sobre `gps_radar_distance_m`.",
      "properties": {
        "disagreed": {
          "title": "Disagreed",
          "type": "boolean"
        }
      },
      "required": [
        "disagreed"
      ],
      "title": "GpsRadarFact",
      "type": "object"
    },
    "MetricStat": {
      "additionalProperties": false,
      "properties": {
        "mean": {
          "title": "Mean",
          "type": "number"
        },
        "max": {
          "title": "Max",
          "type": "number"
        },
        "trend": {
          "anyOf": [
            {
              "$ref": "#/$defs/Trend"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "mean",
        "max",
        "trend"
      ],
      "title": "MetricStat",
      "type": "object"
    },
    "SampleCounts": {
      "additionalProperties": false,
      "properties": {
        "gps": {
          "title": "Gps",
          "type": "integer"
        },
        "radar": {
          "title": "Radar",
          "type": "integer"
        }
      },
      "required": [
        "gps",
        "radar"
      ],
      "title": "SampleCounts",
      "type": "object"
    },
    "SourcePair": {
      "additionalProperties": false,
      "description": "Un valor por fuente de posición; `None` si esa fuente no tiene datos.",
      "properties": {
        "gps": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Gps"
        },
        "radar": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Radar"
        }
      },
      "required": [
        "gps",
        "radar"
      ],
      "title": "SourcePair",
      "type": "object"
    },
    "Trend": {
      "enum": [
        "increasing",
        "decreasing",
        "stable"
      ],
      "title": "Trend",
      "type": "string"
    },
    "WindStat": {
      "additionalProperties": false,
      "description": "Viento de la ventana de `get_track_metrics`, ya calculado para que el modelo no haga\naritmética de ángulos. `from_deg` y `wind_to_deg` son la media vectorial ponderada por la\nvelocidad de los `WindReported` de la ventana; `drift_vs_wind_deg` es la diferencia absoluta\n(0 a 180) entre `drift_direction_deg` y `wind_to_deg` (`None` si no hay deriva).",
      "properties": {
        "mean_speed_mps": {
          "title": "Mean Speed Mps",
          "type": "number"
        },
        "max_gust_mps": {
          "title": "Max Gust Mps",
          "type": "number"
        },
        "from_deg": {
          "title": "From Deg",
          "type": "number"
        },
        "wind_to_deg": {
          "title": "Wind To Deg",
          "type": "number"
        },
        "drift_vs_wind_deg": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Drift Vs Wind Deg"
        },
        "notable": {
          "title": "Notable",
          "type": "boolean"
        },
        "with_drift": {
          "title": "With Drift",
          "type": "boolean"
        },
        "samples": {
          "title": "Samples",
          "type": "integer"
        },
        "last_event_id": {
          "title": "Last Event Id",
          "type": "string"
        }
      },
      "required": [
        "mean_speed_mps",
        "max_gust_mps",
        "from_deg",
        "wind_to_deg",
        "drift_vs_wind_deg",
        "notable",
        "with_drift",
        "samples",
        "last_event_id"
      ],
      "title": "WindStat",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Resultado de `get_track_metrics`. Sin datos de una fuente no se inventa nada: lo que\ndepende de ella va a `None` y `samples` lleva el recuento real.",
