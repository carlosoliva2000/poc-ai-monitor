{
  "$defs": {
    "ConversationId": {
      "enum": [
        "monitor",
        "report",
        "instructor"
      ],
      "title": "ConversationId",
      "type": "string"
    },
    "InstructorCommandName": {
      "description": "Comandos del instructor (v0.18). Más adelante caben otros sin romper el evento.",
      "enum": [
        "set_wind",
        "cancel_wind"
      ],
      "title": "InstructorCommandName",
      "type": "string"
    },
    "InstructorProposal": {
      "additionalProperties": false,
      "description": "Propuesta del agente del instructor (no publica nada: la web la enseña y, si el instructor\nconfirma, manda el comando). `defaults_used`: los parámetros que el modelo rellenó solo.",
      "properties": {
        "command": {
          "$ref": "#/$defs/InstructorCommandName"
        },
        "params": {
          "anyOf": [
            {
              "$ref": "#/$defs/WindCommandParams"
            },
            {
              "type": "null"
            }
          ]
        },
        "defaults_used": {
          "items": {
            "type": "string"
          },
          "title": "Defaults Used",
          "type": "array"
        }
      },
      "required": [
        "command",
        "params",
        "defaults_used"
      ],
      "title": "InstructorProposal",
      "type": "object"
    },
    "WindCommandParams": {
      "additionalProperties": false,
      "description": "Los mismos parámetros que un episodio de viento del escenario, más la duración.\n\n`from_deg` y `speed_mps` empujan al dron; `ramp_s` suaviza la subida y la bajada.\n`duration_s: null` = hasta nuevo aviso. Sin racha desde el contrato v1.0.",
      "properties": {
        "from_deg": {
          "maximum": 360,
          "minimum": 0,
          "title": "From Deg",
          "type": "number"
        },
        "speed_mps": {
          "maximum": 40.0,
          "minimum": 0,
          "title": "Speed Mps",
          "type": "number"
        },
        "ramp_s": {
          "exclusiveMinimum": 0,
          "maximum": 120.0,
          "title": "Ramp S",
          "type": "number"
        },
        "duration_s": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 1800.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Duration S"
        }
      },
      "required": [
        "from_deg",
        "speed_mps",
        "ramp_s",
        "duration_s"
      ],
      "title": "WindCommandParams",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "conversation_id": {
      "$ref": "#/$defs/ConversationId"
    },
    "reply_to": {
      "title": "Reply To",
      "type": "string"
    },
    "text": {
      "title": "Text",
      "type": "string"
    },
    "tool_calls": {
      "items": {
        "type": "string"
      },
      "title": "Tool Calls",
      "type": "array"
    },
    "proposal": {
      "anyOf": [
        {
          "$ref": "#/$defs/InstructorProposal"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "conversation_id",
    "reply_to",
    "text",
    "tool_calls"
  ],
  "title": "AgentReply",
  "type": "object"
}
